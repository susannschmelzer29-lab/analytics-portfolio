# --- Raw data (not in repo, download from Kaggle & mount) --------------------
data/*.csv
!data/train_sample.csv

# --- Generated outputs ---------------------------------------------------------
# The eight CSVs under output/ ARE committed. They are the published result,
# not working scratch: the README quotes them, the dashboard quotes them, and
# tests/test_outputs.py reconciles them in CI. Re-running the notebook here is
# not an option -- it needs the 38 MB Kaggle file, which stays out of the repo.
# Same reasoning as dashboard/data.js below.
output/*
!output/*.csv
figures/
executed.ipynb
executed_test.ipynb

# NOTE: dashboard/data.js IS committed (it powers the static GitHub Pages
# dashboard and is small); it is intentionally not ignored.

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/

