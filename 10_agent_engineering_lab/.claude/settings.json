{
  "permissions": {
    "defaultMode": "default",

    "deny": [
      "Read(./.env)",
      "Write(./data/raw/**)",
      "Edit(./data/raw/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(curl *)",
      "Bash(pip install *)"
    ],

    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)"
    ],

    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(python -m pytest *)",
      "Bash(python -m agentlab.pipeline *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/after_change.sh" }
        ]
      }
    ]
  }
}
